<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payment_provider_ziina" model="payment.provider">
        <field name="name">Ziina</field>
        <field name="code">ziina</field>
        <field name="state">disabled</field>
    </record>

    <record id="payment_ziina_credentials_form" model="ir.ui.view">
        <field name="name">payment.provider.ziina.credentials</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <group name="provider_credentials">
                <field name="ziina_api_key"
                    attrs="{'invisible': [('code', '!=', 'ziina')]}"
                    required="code == 'ziina'"
                    string="API Key"/>
            </group>
        </field>
    </record>
</odoo>
